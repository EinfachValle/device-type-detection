{
  "name": "device-type-detection",
  "version": "2.0.0",
  "description": "Framework-agnostic device type detection with live resize, SSR support, and zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"playground/src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\" \"playground/src/**/*.{ts,tsx}\" \"*.ts\" \"*.json\" jest.polyfills.ts jest.config.cjs",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "playground": "npm run build && cd playground && npm install && npm run dev",
    "prepack": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EinfachValle/device-type-detection.git"
  },
  "keywords": [
    "device",
    "detection",
    "responsive",
    "resize",
    "breakpoints",
    "mobile",
    "tablet",
    "desktop",
    "ssr",
    "framework-agnostic",
    "typescript",
    "zero-dependencies"
  ],
  "author": "Valentin Röhle",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EinfachValle/device-type-detection/issues"
  },
  "homepage": "https://github.com/EinfachValle/device-type-detection#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.15",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "serve": "^14.2.6",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
